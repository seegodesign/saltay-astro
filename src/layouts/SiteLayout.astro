---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | null;
  bodyClass?: string;
}

const { title, description = '', bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? ''} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Hubballi&display=swap" rel="stylesheet" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={bodyClass} transition:animate={fade({ duration: '250ms' })}>
    <slot />
  </body>
</html>
