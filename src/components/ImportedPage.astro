---
import { tinaField } from '@tinacms/astro';
import type { ImportedPagesQuery } from '../../tina/__generated__/types';
interface Props { page: ImportedPagesQuery['importedPages'] }
const { page } = Astro.props;
---
<main id="imported-content" class="imported-page">
  <section class="imported-hero container" class:list={{ 'imported-hero-with-image': page.hero_image }}>
    <div>
      <p class="eyebrow">Saltay Hanalei Bay</p>
      <h1 data-tina-field={tinaField(page, 'heading')}>{page.heading}</h1>
      {page.description && <p class="imported-intro" data-tina-field={tinaField(page, 'description')}>{page.description}</p>}
    </div>
    {page.hero_image && <img src={page.hero_image} alt={page.hero_image_alt ?? ''} width="960" height="640" fetchpriority="high" data-tina-field={tinaField(page, 'hero_image')} />}
  </section>
  <article class="container imported-body" data-tina-field={tinaField(page, 'body_html')} set:html={page.body_html} />
  <section class="imported-booking container">
    <h2>Plan your time at Saltay</h2>
    <div><a class="button" href="/book-with-us/">Book with us</a><a href="/pricing/">Explore treatment pricing →</a></div>
  </section>
</main>
