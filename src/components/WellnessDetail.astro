---
import { tinaField } from '@tinacms/astro';
import type { PageQuery } from '../../tina/__generated__/types';
interface Props { page: Extract<PageQuery['page'], { __typename: 'PageWellnessDetail' }>; }
const { page } = Astro.props;
const items = (page.items ?? []).filter(Boolean);
---
<main id="wellness-content">
  <section class="wellness-hero" aria-labelledby="wellness-title">
    <div class="container wellness-hero-grid">
      <div class="wellness-hero-copy">
        <p class="eyebrow" data-tina-field={tinaField(page, 'eyebrow')}>{page.eyebrow}</p>
        <h1 id="wellness-title" data-tina-field={tinaField(page, 'heading')}>{page.heading}</h1>
        <p class="wellness-intro" data-tina-field={tinaField(page, 'introduction')}>{page.introduction}</p>
        <a class="button" href="#offerings">Explore the offerings</a>
      </div>
      <img class="wellness-hero-image" src={page.hero_image ?? ''} alt={page.hero_image_alt ?? ''} width="720" height="800" data-tina-field={tinaField(page, 'hero_image')} fetchpriority="high" />
    </div>
  </section>
  <div class="container menu-layout" id="offerings">
    <aside class="menu-index"><p class="eyebrow" data-tina-field={tinaField(page, 'menu_heading')}>{page.menu_heading}</p><nav aria-label="Offerings">{items.map((item, index) => <a href={`#${item.id}`}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{item.title}</a>)}</nav></aside>
    <div data-tina-field={tinaField(page, 'items')}>
      {items.map(item => <section class="menu-section wellness-offering" id={item.id} aria-labelledby={`${item.id}-title`}>
        <h2 id={`${item.id}-title`} data-tina-field={tinaField(item, 'title')}>{item.title}</h2>
        {item.text && <p data-tina-field={tinaField(item, 'text')}>{item.text}</p>}
        {item.details_html && <div class="session-details" data-tina-field={tinaField(item, 'details_html')} set:html={item.details_html} />}
      </section>)}
      <div class="wellness-planning"><p data-tina-field={tinaField(page, 'note')}>{page.note}</p><a class="menu-book-link" href={page.pricing_url ?? '/pricing/'}>Explore treatment pricing <span aria-hidden="true">→</span></a></div>
    </div>
  </div>
  <section class="menu-booking" aria-labelledby="wellness-booking-title"><div class="container">
    <h2 id="wellness-booking-title" data-tina-field={tinaField(page, 'booking_heading')}>{page.booking_heading}</h2>
    <p data-tina-field={tinaField(page, 'booking_text')}>{page.booking_text}</p>
    <a class="button" href={page.booking_url ?? '/book-with-us/'} data-tina-field={tinaField(page, 'booking_label')}>{page.booking_label}</a>
    <nav class="pricing-page-links" aria-label="Related experiences"><a href="/signature-experiences/">Signature Experiences</a><a href="/spa-add-ons/">Wellness Enhancements</a><a href="/treatments/">All treatments</a></nav>
  </div></section>
</main>
