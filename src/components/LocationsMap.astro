---
import 'leaflet/dist/leaflet.css';
interface Props {
  locations: { id?: string | null; name?: string | null; address?: string | null }[];
}
const { locations } = Astro.props;
// Shopping-center coordinates: Ching Young Village (OSM way 465558029)
// and Anahola Marketplace (anaholamarketplace.com event location metadata).
const coordinates: Record<string, [number, number]> = {
  'hanalei-bay': [22.20328, -159.49674],
  'saltay-ii': [22.1337923, -159.3036474],
};
const pins = locations.filter(location => location.id && coordinates[location.id]).map(location => ({
  name: location.name ?? '',
  address: location.address ?? '',
  coordinates: coordinates[location.id!],
}));
---
<section class="container locations-map-section" aria-label="Map of our two locations">
  <saltay-locations-map data-pins={JSON.stringify(pins)}>
    <div class="locations-map" aria-label="Saltay locations in Hanalei and Anahola" role="region"></div>
  </saltay-locations-map>
  <p class="locations-map-caption">Find us in Hanalei and Anahola. Select a pin for directions.</p>
</section>

<script>
  import * as L from 'leaflet';

  class LocationsMap extends HTMLElement {
    map?: L.Map;

    connectedCallback() {
      if (this.map) return;
      const container = this.querySelector<HTMLElement>('.locations-map');
      const pins: { name: string; address: string; coordinates: [number, number] }[] = JSON.parse(this.dataset.pins || '[]');
      if (!container || !pins.length) return;

      const map = L.map(container, { scrollWheelZoom: false });
      this.map = map;
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      const markers = pins.map((pin, index) => {
        const popup = document.createElement('div');
        const heading = document.createElement('strong');
        heading.textContent = pin.name;
        const address = document.createElement('p');
        address.textContent = pin.address;
        const directions = document.createElement('a');
        directions.textContent = 'Get directions';
        directions.href = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${pin.name}, ${pin.address}, Kauai, Hawaii`)}`;
        popup.append(heading, address, directions);
        return L.marker(pin.coordinates, {
          icon: L.divIcon({
            className: 'location-pin',
            html: `<span><b>${index + 1}</b></span>`,
            iconSize: [36, 44],
            iconAnchor: [18, 44],
            popupAnchor: [0, -40],
          }),
          title: pin.name,
          alt: pin.name,
        }).addTo(map).bindPopup(popup).bindTooltip(pin.name, { direction: 'top', offset: [0, -44] });
      });
      map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [55, 65], maxZoom: 11 });
    }

    disconnectedCallback() {
      this.map?.remove();
      this.map = undefined;
    }
  }

  if (!customElements.get('saltay-locations-map')) customElements.define('saltay-locations-map', LocationsMap);
</script>
