---
interface Props {
  locations: { id?: string | null; name?: string | null; address?: string | null }[];
}
const { locations } = Astro.props;
const maps = locations.filter(location => location.address).map(location => ({
  name: location.name || 'Saltay',
  // Use the street address without shopping-center notes for an exact place search.
  query: `${location.address!.split('|')[0].trim()}, Kauai, Hawaii`,
}));
---
{maps.length > 0 && <section class="container locations-map-section" aria-label="Maps of our locations">
  <div class="locations-maps">
    {maps.map(location => <figure class="location-map">
      <figcaption>{location.name}</figcaption>
      <iframe
        class="locations-map"
        title={`Google Maps location of ${location.name}`}
        src={`https://www.google.com/maps?q=${encodeURIComponent(location.query)}&z=15&output=embed`}
        width="600"
        height="400"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <a class="location-map-link" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(location.query)}`} aria-label={`Get directions to ${location.name}`}>Get directions</a>
    </figure>)}
  </div>
  <p class="locations-map-caption">Find us in Hanalei and Anahola. Get directions to plan your visit.</p>
</section>}
