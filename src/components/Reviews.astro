---
import { tinaField } from '@tinacms/astro';
import DiagonalArrow from './DiagonalArrow.astro';
import type { PageHomeBlocksReviews } from '../../tina/__generated__/types';
interface Props { data: PageHomeBlocksReviews; }
const { data } = Astro.props;
const reviews = (data.reviews ?? []).filter(Boolean);
---
{reviews.length > 0 && <section class="reviews" aria-label="Guest reviews">
  <div class="container">
    <div class="reviews-intro">
      <p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>
      <h2 data-tina-field={tinaField(data, 'heading')}>{data.heading}</h2>
    </div>
    <div class="reviews-grid" data-tina-field={tinaField(data, 'reviews')}>
      {reviews.map(review => <figure class="review">
        <div class="review-stars" role="img" aria-label={`${review.rating} out of 5 stars`} data-tina-field={tinaField(review, 'rating')}>
          <span aria-hidden="true">{'★'.repeat(Math.min(5, Math.max(1, Math.round(review.rating))))}</span>
        </div>
        <blockquote><p data-tina-field={tinaField(review, 'quote')}>“{review.quote}”</p></blockquote>
        <figcaption>
          <span class="review-author" data-tina-field={tinaField(review, 'author')}>{review.author}</span>
          <a href={review.url} target="_blank" rel="noopener noreferrer" aria-label={`Read ${review.author}'s full review on Google (opens in a new tab)`} data-tina-field={tinaField(review, 'url')}>Google review <span aria-hidden="true"><DiagonalArrow /></span></a>
        </figcaption>
      </figure>)}
    </div>
    <div class="reviews-footer">
      <a class="reviews-link" href={data.link_url} target="_blank" rel="noopener noreferrer" data-tina-field={tinaField(data, 'link_label')}>{data.link_label} <span aria-hidden="true"><DiagonalArrow /></span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </div>
</section>}

<style>
  .reviews { padding: clamp(64px, 7vw, 100px) 0; background: var(--cream); }
  .reviews-intro { text-align: center; }
  .reviews-intro .eyebrow { letter-spacing: .14em; margin-bottom: 16px; }
  .reviews-intro h2 { font-size: clamp(36px, 3.5vw, 48px); text-wrap: balance; }
  .reviews-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 48px; }
  .review { display: flex; flex-direction: column; margin: 0; padding: 8px clamp(24px, 3vw, 48px); text-align: center; }
  .review + .review { border-left: 1px solid #a47e3740; }
  .review-stars { color: var(--gold-light); font-size: 17px; letter-spacing: .18em; }
  blockquote { flex: 1; margin: 20px 0 28px; }
  blockquote p { margin: 0; color: #735e3f; font-family: "EB Garamond", Georgia, serif; font-size: clamp(26px, 2.4vw, 32px); line-height: 1.25; text-wrap: balance; }
  figcaption { display: grid; gap: 2px; }
  .review-author { color: #514b3c; font-size: 21px; }
  figcaption a { font-size: 17px; }
  .reviews-footer { margin-top: 44px; text-align: center; }
  .reviews-link { display: inline-flex; align-items: center; gap: 14px; padding: 6px 0; border-bottom: 1px solid #a47e3770; color: #735e3f; font-size: 20px; }
  @media (max-width: 700px) {
    .reviews-grid { grid-template-columns: 1fr; margin-top: 24px; }
    .review { padding: 28px 16px; }
    .review + .review { border-left: 0; border-top: 1px solid #a47e3740; }
    blockquote { margin: 16px auto 20px; max-width: 340px; }
    .reviews-footer { margin-top: 16px; }
  }
</style>
