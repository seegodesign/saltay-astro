---
import { tinaField } from '@tinacms/astro';
import type { PageQuery } from '../../tina/__generated__/types';
interface Props { page: Extract<PageQuery['page'], { __typename: 'PageSpaAddOns' }>; }
const { page } = Astro.props;
---
<main id="spa-add-ons-content">
  <section class="menu-hero enhancements-hero" aria-labelledby="enhancements-title">
    <div class="container">
      <p class="eyebrow" data-tina-field={tinaField(page, 'eyebrow')}>{page.eyebrow}</p>
      <h1 id="enhancements-title" data-tina-field={tinaField(page, 'heading')}>{page.heading}</h1>
      <p class="menu-intro" data-tina-field={tinaField(page, 'introduction')}>{page.introduction}</p>
      <p class="enhancements-note" data-tina-field={tinaField(page, 'session_note')}>{page.session_note}</p>
      <a class="button" href="#enhancements-menu">Explore enhancements</a>
    </div>
  </section>
  <section class="container enhancements-menu" id="enhancements-menu" aria-labelledby="enhancements-menu-title">
    <h2 id="enhancements-menu-title" data-tina-field={tinaField(page, 'menu_heading')}>{page.menu_heading}</h2>
    <ul class="enhancements-list" data-tina-field={tinaField(page, 'enhancements')}>
      {(page.enhancements ?? []).filter(Boolean).map(enhancement => <li>
        <span data-tina-field={tinaField(enhancement, 'name')}>{enhancement.name}</span>
        <span class="session-price" data-tina-field={tinaField(enhancement, 'price')}>{enhancement.price}</span>
      </li>)}
    </ul>
  </section>
  <section class="menu-booking" aria-labelledby="enhancements-booking-title"><div class="container">
    <h2 id="enhancements-booking-title" data-tina-field={tinaField(page, 'booking_heading')}>{page.booking_heading}</h2>
    <p data-tina-field={tinaField(page, 'booking_text')}>{page.booking_text}</p>
    <a class="button" href={page.booking_url ?? ''} data-tina-field={tinaField(page, 'booking_label')}>{page.booking_label}</a>
    <nav class="pricing-page-links" aria-label="Related treatments"><a href="/treatments/">Explore treatments</a><a href="/pricing/">View treatment pricing</a></nav>
  </div></section>
</main>
