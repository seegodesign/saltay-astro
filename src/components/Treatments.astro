---
import { tinaField } from '@tinacms/astro';
import LinkArrow from './LinkArrow.astro';
const { data } = Astro.props;
const { services } = data;
---
<section class="treatments"><div class="container treatment-grid" data-tina-field={tinaField(data, 'services')}>
{(services ?? []).filter(Boolean).map(service => <article class="treatment-card">
  <p class="eyebrow" data-tina-field={tinaField(service, 'eyebrow')}>{service.eyebrow}</p>
  <h2 data-tina-field={tinaField(service, 'title')}>{service.title}</h2>
  <div class="treatment-visual">
    <img src={service.image} alt={service.image_alt} width="495" height="640" loading="lazy" data-tina-field={tinaField(service, 'image')} />
    <div class="treatment-copy">
      <div data-tina-field={tinaField(service, 'paragraphs')}>{(service.paragraphs ?? []).filter(Boolean).map(text=><p data-tina-field={tinaField(text, 'text')}>{text.text}</p>)}</div>
      <a class="treatment-link" href={service.link_url || '/treatments/'} data-tina-field={tinaField(service, 'link_label')}>{service.link_label || 'Explore treatments'} <LinkArrow /></a>
    </div>
  </div>
</article>)}
</div></section>
