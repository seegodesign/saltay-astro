---
import { tinaField } from '@tinacms/astro';
const { data } = Astro.props;
const { columns, background_image } = data;
---
<section class="care" style={`--section-image: url('${background_image}')`}><div class="container care-grid" data-tina-field={tinaField(data, 'columns')}>
{(columns ?? []).filter(Boolean).map((col, index)=><article class:list={["care-card", { "care-remote": index === 1 }]}><h2 data-tina-field={tinaField(col, 'title')}>{col.title}</h2><div class="care-body" data-tina-field={tinaField(col, 'body_html')} set:html={col.body_html}></div></article>)}
</div></section>
