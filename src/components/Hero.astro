---
import { tinaField } from "@tinacms/astro";
import LinkArrow from "./LinkArrow.astro";
import ScrollFade from "./ScrollFade.astro";
const { data } = Astro.props;
const { heading, description, image } = data;
---

<section class="hero">
  <img
    class="hero-image"
    data-tina-field={tinaField(data, "image")}
    src={image}
    alt=""
    width="1800"
    height="796"
    fetchpriority="high"
  />
  <ScrollFade />
  <div class="container hero-copy">
    <p class="hero-kicker">
      <span aria-hidden="true"></span>Elevated Healing. Lasting Transformation.<span
        aria-hidden="true"></span>
    </p>
    <h1 data-tina-field={tinaField(data, "heading")}>{heading}</h1>
    <p
      class="hero-description"
      data-tina-field={tinaField(data, "description")}
    >
      {description}
    </p>
    <div class="hero-actions">
      <a class="button" href="/book-with-us/">Book your experience</a>
      <a class="hero-link" href="/treatments/">Explore treatments <LinkArrow /></a>
    </div>
    <p class="hero-locations">By appointment in Hanalei &amp; Anahola · <a href="/locations/">Our locations</a></p>
    <img
      class="hero-rule"
      src="/assets/spiral-rule.png"
      alt=""
      width="739"
      height="118"
    />
  </div>
</section>
