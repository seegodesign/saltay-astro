---
import { tinaField } from '@tinacms/astro';
const { data } = Astro.props;
const { eyebrow, heading, description, button, phone, statement, background_image } = data;
---
<section class="booking" style={`--section-image: url('${background_image}')`}><div class="container booking-grid">
<div class="booking-card"><p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{eyebrow}</p><h2 data-tina-field={tinaField(data, 'heading')}>{heading}</h2><p data-tina-field={tinaField(data, 'description')}>{description}</p><a href="/book-with-us/" class="button booking-button" data-tina-field={tinaField(data, 'button')}>{button}</a><a href="tel:+18088558718" class="phone"><span aria-hidden="true">☎</span> <span data-tina-field={tinaField(data, 'phone')}>{phone}</span></a></div>
<h3 data-tina-field={tinaField(data, 'statement')}>{statement}</h3>
</div></section>
