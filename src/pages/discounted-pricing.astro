---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import DiscountedPricing from '../components/DiscountedPricing.astro';
import SiteHeader from '../components/SiteHeader.astro';
import home from '../data/home.json';
import { getDiscountedPricing } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/pricing.css';
import '../styles/discounted-pricing.css';
const { data: { page } } = await getDiscountedPricing();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="pricing-page">
  <a class="skip-link" href="#discounted-pricing-content">Skip to pricing</a>
  <SiteHeader home={home} active="Discounted Pricing" />
  <TinaIsland name="discountedPricing" wrapper={islands.discountedPricing.wrapper} primary>
    <DiscountedPricing page={page} />
  </TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
