---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import About from "../components/About.astro";
import SiteHeader from "../components/SiteHeader.astro";
import home from "../data/home.json";
import { getAbout } from "../lib/tina/data";
import { islands } from "../lib/tina/islands";
import "../styles/about.css";
const {
  data: { page },
} = await getAbout();
---
<SiteLayout title={page.title} description={page.description ?? ""} bodyClass="about-page">
  <a class="about-skip" href="#about-content">Skip to content</a>
  <SiteHeader home={home} active="About" />
  <TinaIsland name="about" wrapper={islands.about.wrapper} primary
    ><About page={page} /></TinaIsland
  >
  <SiteFooter home={home} />
</SiteLayout>
