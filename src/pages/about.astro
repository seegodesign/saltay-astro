---
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import About from "../components/About.astro";
import SiteHeader from "../components/SiteHeader.astro";
import home from "../data/home.json";
import { getAbout } from "../lib/tina/data";
import { islands } from "../lib/tina/islands";
import "../styles/global.css";
import "../styles/about.css";
const {
  data: { page },
} = await getAbout();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description ?? ""} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Hubballi&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="about-page">
    <a class="about-skip" href="#about-content">Skip to content</a>
    <SiteHeader home={home} active="About" />
    <TinaIsland name="about" wrapper={islands.about.wrapper} primary
      ><About page={page} /></TinaIsland
    >
    <SiteFooter home={home} />
  </body>
</html>
