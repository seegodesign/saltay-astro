---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Home from '../components/Home.astro';
import { getHome } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/global.css';
const { data: { page: home } } = await getHome();
const hero = home.blocks?.find(block => block?.__typename === 'PageHomeBlocksHero');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{home.title}</title><meta name="description" content={hero?.description ?? ''}/><meta name="robots" content="noindex,nofollow"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Hubballi&display=swap" rel="stylesheet"/></head>
<body>
<TinaIsland name="home" wrapper={islands.home.wrapper} primary>
  <Home home={home} />
</TinaIsland>
</body></html>
