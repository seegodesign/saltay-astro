---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PricingMenu from '../components/PricingMenu.astro';
import SiteHeader from '../components/SiteHeader.astro';
import home from '../data/home.json';
import { getPricing } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/pricing.css';
const { data: { page } } = await getPricing();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="pricing-page">
  <a class="skip-link" href="#treatment-menu">Skip to pricing</a>
  <SiteHeader home={home} active="Pricing" />
  <TinaIsland name="pricing" wrapper={islands.pricing.wrapper} primary>
    <PricingMenu page={page} />
  </TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
