---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import TreatmentsOverview from '../components/TreatmentsOverview.astro';
import { getTreatments } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import home from '../data/home.json';
import '../styles/global.css';
import '../styles/treatments.css';
const { data: { page } } = await getTreatments();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description ?? ''} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Hubballi&display=swap" rel="stylesheet" />
  </head>
  <body class="treatments-overview-page">
    <a class="overview-skip" href="#treatments-content">Skip to treatments</a>
    <SiteHeader home={home} active="Treatments" />
    <TinaIsland name="treatments" wrapper={islands.treatments.wrapper} primary><TreatmentsOverview page={page} /></TinaIsland>
    <SiteFooter home={home} />
  </body>
</html>
