---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import TreatmentsOverview from '../components/TreatmentsOverview.astro';
import { getTreatments } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import home from '../data/home.json';
const { data: { page } } = await getTreatments();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="treatments-overview-page">
  <a class="overview-skip" href="#treatments-content">Skip to treatments</a>
  <SiteHeader home={home} active="Treatments" />
  <TinaIsland name="treatments" wrapper={islands.treatments.wrapper} primary><TreatmentsOverview page={page} /></TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
