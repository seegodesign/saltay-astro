---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import WellnessDetail from '../components/WellnessDetail.astro';
import SiteHeader from '../components/SiteHeader.astro';
import home from '../data/home.json';
import { getAcupuncture } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/pricing.css';
import '../styles/wellness-detail.css';
const { data: { page } } = await getAcupuncture();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="pricing-page">
  <a class="skip-link" href="#wellness-content">Skip to content</a>
  <SiteHeader home={home} active="Acupuncture" />
  <TinaIsland name="acupuncture" wrapper={islands.acupuncture.wrapper} primary>
    <WellnessDetail page={page} />
  </TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
