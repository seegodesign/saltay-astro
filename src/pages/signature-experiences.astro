---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SignatureExperiences from '../components/SignatureExperiences.astro';
import SiteHeader from '../components/SiteHeader.astro';
import home from '../data/home.json';
import { getSignatureExperiences } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/pricing.css';
import '../styles/signature-experiences.css';
const { data: { page } } = await getSignatureExperiences();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="pricing-page">
  <a class="skip-link" href="#signature-experiences-content">Skip to experiences</a>
  <SiteHeader home={home} active="Signature Experiences" />
  <TinaIsland name="signatureExperiences" wrapper={islands.signatureExperiences.wrapper} primary>
    <SignatureExperiences page={page} />
  </TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
