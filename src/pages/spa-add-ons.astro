---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SpaAddOns from '../components/SpaAddOns.astro';
import SiteHeader from '../components/SiteHeader.astro';
import home from '../data/home.json';
import { getSpaAddOns } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/pricing.css';
import '../styles/spa-add-ons.css';
const { data: { page } } = await getSpaAddOns();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="pricing-page">
  <a class="skip-link" href="#spa-add-ons-content">Skip to enhancements</a>
  <SiteHeader home={home} active="Spa Add-ons" />
  <TinaIsland name="spaAddOns" wrapper={islands.spaAddOns.wrapper} primary>
    <SpaAddOns page={page} />
  </TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
