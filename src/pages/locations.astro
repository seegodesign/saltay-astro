---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Locations from '../components/Locations.astro';
import SiteHeader from '../components/SiteHeader.astro';
import home from '../data/home.json';
import { getLocations } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import '../styles/pricing.css';
import '../styles/locations.css';
const { data: { page } } = await getLocations();
---
<SiteLayout title={page.title} description={page.description ?? ''} bodyClass="pricing-page">
  <a class="skip-link" href="#locations-content">Skip to content</a>
  <SiteHeader home={home} active="Locations" />
  <TinaIsland name="locations" wrapper={islands.locations.wrapper} primary>
    <Locations page={page} />
  </TinaIsland>
  <SiteFooter home={home} />
</SiteLayout>
